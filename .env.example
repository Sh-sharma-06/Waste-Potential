# ─── Core application ─────────────────────────────────────────────────────────
# Display name for the FastAPI app (app/config.py → Settings.app_name).
WP_APP_NAME=Waste-Potential API

# Runtime environment: development | test | production (app/config.py).
WP_ENVIRONMENT=development

# Maximum in-memory simulation run records (app/platform/runs.py).
WP_RUN_STORE_MAX_RUNS=1000

# ─── Gemini AI (model) ────────────────────────────────────────────────────────
# Gemini model name used by all Gemini callers; default "gemini-2.5-flash"
# (app/config.py, app/ml/vision_router.py, app/pathways/explain_router.py).
GEMINI_MODEL=gemini-2.5-flash

# ─── Gemini AI (API keys) ─────────────────────────────────────────────────────
# Key for the AI assistant parse endpoint (app/platform/assistant/router.py).
GEMINI_API_KEY_PARSER=your-gemini-api-key-here

# Key for the AI assistant advisor endpoint (app/platform/assistant/router.py).
GEMINI_API_KEY_ADVISOR=your-gemini-api-key-here

# Key for the AI assistant audit endpoint (app/platform/assistant/router.py).
GEMINI_API_KEY_AUDIT=your-gemini-api-key-here

# Key for the vision classify/advice endpoints (app/ml/vision_router.py).
GEMINI_API_KEY_VISION=your-gemini-api-key-here

# Key for the pathways explain endpoint (app/pathways/explain_router.py).
GEMINI_API_KEY_EXPLAIN=your-gemini-api-key-here

# ─── External services ────────────────────────────────────────────────────────
# OpenRouteService — road-distance matrix for transport cost estimation.
# Get a free key at https://openrouteservice.org/dev/#/signup
# Used by: app/config.py → OPEN_ROUTE_SERVICE_API_KEY
OPEN_ROUTE_SERVICE_API_KEY=your-ors-api-key-here

# Google Places API — nearby waste-facility and buyer search (50 km radius).
# Enable "Places API" in your Google Cloud project; restrict the key by IP/referer.
# https://developers.google.com/maps/documentation/places/web-service/get-api-key
# Used by: app/config.py → GOOGLE_PLACES_API_KEY
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# Open-Meteo is a public free API; no key required for standard use.
# This variable is reserved for future premium / commercial access (app/config.py).
OPEN_METEO_API_KEY=

# ─── Geocoding ────────────────────────────────────────────────────────────────
# Contact email or URL sent in the Nominatim User-Agent header (required by the
# Nominatim usage policy). Used by: app/services/geocode_client.py
GEOCODE_CONTACT=your-email@example.com

# ─── Model registry ───────────────────────────────────────────────────────────
# Absolute or relative path to docs/parameter_registry.csv.
# Defaults to docs/parameter_registry.csv in the repo root when unset.
# Used by: app/core_engine/registry.py
WP_REGISTRY_PATH=

# ─── ML model directory ───────────────────────────────────────────────────────
# Directory containing trained yield-model bundles (*.joblib).
# Defaults to backend/models/ in the repo root when unset.
# Used by: app/ml/registry/store.py
MODEL_DIR=
