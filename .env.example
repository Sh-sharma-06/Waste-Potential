# ─── Core application ─────────────────────────────────────────────────────────
WP_APP_NAME=Waste-Potential API
WP_ENVIRONMENT=development
WP_RUN_STORE_MAX_RUNS=1000

# ─── Gemini AI ────────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY_AUDIT=
GEMINI_API_KEY_ADVISOR=
GEMINI_API_KEY_PARSER=

# ─── External API keys (P3 scope) ─────────────────────────────────────────────
# OpenRouteService — road distance matrix for transport cost estimation.
# Get a free key at https://openrouteservice.org/dev/#/signup
OPEN_ROUTE_SERVICE_API_KEY=

# Google Places API — nearby waste facility search (50 km radius).
# Enable the "Places API" in your Google Cloud project and restrict the key.
# https://developers.google.com/maps/documentation/places/web-service/get-api-key
GOOGLE_PLACES_API_KEY=

# Open-Meteo — public free API, no key required.
# Reserved for future premium access.
OPEN_METEO_API_KEY=
